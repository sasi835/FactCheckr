{
  "name": "factcheckr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:demo\" \"npm:client\"",
    "dev:mongo": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --env-file-if-exists=.env server/index.js",
    "server:demo": "node --env-file-if-exists=.env server/index.js --demo",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node --env-file-if-exists=.env tests/live-smoke.mjs",
    "seed": "node --env-file-if-exists=.env server/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "vite": "^7.1.9"
  }
}
